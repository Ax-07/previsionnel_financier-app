model ResultatAnnuel {
  id                        String   @id @default(cuid())
  annee                     Int
  chiffreAffairesHT         Decimal  @db.Decimal(15, 2)
  autresProduits            Decimal  @default(0) @db.Decimal(15, 2)
  subventionsExploitation   Decimal  @default(0) @db.Decimal(15, 2)
  totalProduitsExploitation Decimal  @db.Decimal(15, 2)
  achatsMarchandises        Decimal  @default(0) @db.Decimal(15, 2)
  variationStocks           Decimal  @default(0) @db.Decimal(15, 2)
  chargesExternes           Decimal  @db.Decimal(15, 2)
  impotsTaxes               Decimal  @default(0) @db.Decimal(15, 2)
  chargesPersonnel          Decimal  @db.Decimal(15, 2)
  dotationsAmortissements   Decimal  @db.Decimal(15, 2)
  autresCharges             Decimal  @default(0) @db.Decimal(15, 2)
  totalChargesExploitation  Decimal  @db.Decimal(15, 2)
  margeCommerciale          Decimal  @db.Decimal(15, 2)
  productionExercice        Decimal  @db.Decimal(15, 2)
  valeurAjoutee             Decimal  @db.Decimal(15, 2)
  excedentBrutExploitation  Decimal  @db.Decimal(15, 2)
  resultatExploitation      Decimal  @db.Decimal(15, 2)
  produitsFinanciers        Decimal  @default(0) @db.Decimal(15, 2)
  chargesFinancieres        Decimal  @db.Decimal(15, 2)
  resultatFinancier         Decimal  @db.Decimal(15, 2)
  resultatCourantAvantImpot Decimal  @db.Decimal(15, 2)
  resultatExceptionnel      Decimal  @default(0) @db.Decimal(15, 2)
  impotSocietes             Decimal  @db.Decimal(15, 2)
  resultatNet               Decimal  @db.Decimal(15, 2)
  capaciteAutofinancement   Decimal  @db.Decimal(15, 2)
  chargesFixesTotales       Decimal  @db.Decimal(15, 2)
  chargesVariablesTotales   Decimal  @db.Decimal(15, 2)
  margeCouvVariables        Decimal  @db.Decimal(15, 2)
  tauxMCVPourcentage        Decimal  @db.Decimal(6, 4)
  seuilRentabiliteCA        Decimal  @db.Decimal(15, 2)
  pointMortJours            Decimal  @db.Decimal(8, 2)
  calculeLe                 DateTime @default(now())
  version                   Int      @default(1)
  scenarioId                String
  scenario                  Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, annee])
  @@map("resultat_annuel")
}

model BilanAnnuel {
  id                        String   @id @default(cuid())
  annee                     Int
  immobilisationsBrutes     Decimal  @db.Decimal(15, 2)
  amortissementsCumules     Decimal  @db.Decimal(15, 2)
  actifImmobiliseNet        Decimal  @db.Decimal(15, 2)
  stocks                    Decimal  @default(0) @db.Decimal(15, 2)
  creancesClients           Decimal  @db.Decimal(15, 2)
  tvaARecuperer             Decimal  @default(0) @db.Decimal(15, 2)
  autresCreances            Decimal  @default(0) @db.Decimal(15, 2)
  disponibilites            Decimal  @db.Decimal(15, 2)
  totalActif                Decimal  @db.Decimal(15, 2)
  capitalSocial             Decimal  @db.Decimal(15, 2)
  reserves                  Decimal  @default(0) @db.Decimal(15, 2)
  reportNouveau             Decimal  @default(0) @db.Decimal(15, 2)
  resultatExercice          Decimal  @db.Decimal(15, 2)
  subventionsInvestissement Decimal  @default(0) @db.Decimal(15, 2)
  totalCapitauxPropres      Decimal  @db.Decimal(15, 2)
  dettesFinancieresMLT      Decimal  @db.Decimal(15, 2)
  dettesCT                  Decimal  @db.Decimal(15, 2)
  dettesFournisseurs        Decimal  @db.Decimal(15, 2)
  dettesFiscalesSociales    Decimal  @db.Decimal(15, 2)
  tvaADecaisser             Decimal  @default(0) @db.Decimal(15, 2)
  autresDettes              Decimal  @default(0) @db.Decimal(15, 2)
  totalPassif               Decimal  @db.Decimal(15, 2)
  bfrExploitation           Decimal  @db.Decimal(15, 2)
  frng                      Decimal  @db.Decimal(15, 2)
  tresorerieNette           Decimal  @db.Decimal(15, 2)
  ecartBilan                Decimal  @default(0) @db.Decimal(15, 2)
  calculeLe                 DateTime @default(now())
  version                   Int      @default(1)
  scenarioId                String
  scenario                  Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, annee])
  @@map("bilan_annuel")
}

model TresorerieMensuelle {
  id                       String   @id @default(cuid())
  annee                    Int
  mois                     Int
  encaissementsClients     Decimal  @db.Decimal(15, 2)
  subventionsPercues       Decimal  @default(0) @db.Decimal(15, 2)
  apportsPercus            Decimal  @default(0) @db.Decimal(15, 2)
  autresEncaissements      Decimal  @default(0) @db.Decimal(15, 2)
  totalEncaissements       Decimal  @db.Decimal(15, 2)
  paiementsFournisseurs    Decimal  @db.Decimal(15, 2)
  chargesPersonnelDecaisse Decimal  @db.Decimal(15, 2)
  chargesSociales          Decimal  @db.Decimal(15, 2)
  remboursementEmprunts    Decimal  @db.Decimal(15, 2)
  investissements          Decimal  @default(0) @db.Decimal(15, 2)
  tvaPayer                 Decimal  @default(0) @db.Decimal(15, 2)
  impotSocietesAcompte     Decimal  @default(0) @db.Decimal(15, 2)
  autresDecaissements      Decimal  @default(0) @db.Decimal(15, 2)
  totalDecaissements       Decimal  @db.Decimal(15, 2)
  fluxNetMois              Decimal  @db.Decimal(15, 2)
  soldeDebut               Decimal  @db.Decimal(15, 2)
  soldeFin                 Decimal  @db.Decimal(15, 2)
  tvaCollectee             Decimal  @default(0) @db.Decimal(15, 2)
  tvaDeductible            Decimal  @default(0) @db.Decimal(15, 2)
  calculeLe                DateTime @default(now())
  version                  Int      @default(1)
  scenarioId               String
  scenario                 Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, annee, mois])
  @@map("tresorerie_mensuelle")
}

model SeuilRentabilite {
  id                      String   @id @default(cuid())
  annee                   Int
  chargesFixesTotales     Decimal  @db.Decimal(15, 2)
  chargesVariablesTotales Decimal  @db.Decimal(15, 2)
  margeSurCoutsVariables  Decimal  @db.Decimal(15, 2)
  tauxMCV                 Decimal  @db.Decimal(6, 4)
  seuilRentabiliteCA      Decimal  @db.Decimal(15, 2)
  pointMortJours          Decimal  @db.Decimal(8, 2)
  margeSecurite           Decimal  @db.Decimal(15, 2)
  indiceSecurite          Decimal  @db.Decimal(6, 4)
  leviersOperationnel     Decimal  @db.Decimal(8, 4)
  calculeLe               DateTime @default(now())
  scenarioId              String
  scenario                Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, annee])
  @@map("seuil_rentabilite")
}
